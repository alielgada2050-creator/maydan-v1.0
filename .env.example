# ── Copy to .env for local runs only. In Google Cloud, put every secret in Secret Manager (see docs/DEPLOY.md). ──
NODE_ENV=development
PORT=8080
# file (local) | firestore (Cloud Run)
STORE=file
DATA_DIR=./data
# attachments: empty = DATA_DIR/files locally; a Cloud Storage bucket name in production
FILES_BUCKET=
# ≥ 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# one-time token to create the first admin; remove it after setup
SETUP_TOKEN=

# OTP delivery: console (development only) | webhook | twilio | unifonic
OTP_PROVIDER=console
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
UNIFONIC_APPSID=
UNIFONIC_SENDER=

# AI providers (OpenAI-compatible). A provider is used only when its MODEL (and key/URL) is set.
AI_ORDER=NINEROUTER,OPENAI,GROQ,OPENROUTER,DEEPSEEK,GEMINI
NINEROUTER_URL=
NINEROUTER_API_KEY=
NINEROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Odoo External API (JSON-RPC). Use a dedicated read-only user + API key.
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# Google: sign-in (OAuth Web client ID), maps (Map Tiles API key restricted to your site), optional company domain
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_KEY=
GOOGLE_ALLOWED_DOMAIN=

# OTP by e-mail through Gmail / Google Workspace (app password) or any SMTP server
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Company system / ERP: every data update is POSTed here, signed with HMAC-SHA256 (X-Maydan-Signature)
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=

# OmniRoute free AI gateway (combo name as the model, e.g. free-forever); key from its dashboard if requireApiKey is on
OMNIROUTE_URL=
OMNIROUTE_MODEL=free-forever
OMNIROUTE_API_KEY=

# FreeLLMAPI (tashfeenahmed/freellmapi): unified key from its dashboard; model auto | auto:fast | auto:smart
FREELLMAPI_URL=
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=
